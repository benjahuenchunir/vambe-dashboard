# Copy to .env.local and fill in from your Supabase project settings (Project Settings -> API).
# SUPABASE_SERVICE_ROLE_KEY is used server-side only (route handlers, Server Components) —
# never prefix it with NEXT_PUBLIC_ or import lib/supabase.ts from a "use client" file.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PIPELINE_API_SECRET=your-pipeline-api-secret
